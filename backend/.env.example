# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (matches docker-compose defaults)
DATABASE_URL=postgres://protest:protest@localhost:5432/protest_tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_ROUNDS=12

# Google Directions API (server-side key; separate from the frontend Maps JS key).
# Leave blank for now — the /match endpoint returns a clear error until this is set.
GOOGLE_DIRECTIONS_API_KEY=

# CORS: comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Conflict buffer around protest routes, in meters
MATCH_BUFFER_METERS=200

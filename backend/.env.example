# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (matches docker-compose defaults)
DATABASE_URL=postgres://protest:protest@localhost:5432/protest_tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_ROUNDS=12

# OpenRouteService (routing + avoid-area). Free hosted key at
# https://openrouteservice.org/dev/#/signup — or point ORS_BASE_URL at a
# self-hosted instance. Leave ORS_API_KEY blank for now; /match returns a clear
# 503 until it is set.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=driving-car

# CORS: comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Trusted proxy hops so req.ip is the real client IP behind a load balancer.
# "false" locally; in prod set to "true" or the number of hops (e.g. 1).
# Rate limiting keys on the client IP, so this must be correct in production.
TRUST_PROXY=false

# Conflict buffer around protest routes, in meters
MATCH_BUFFER_METERS=200

# How long a community parking "chip" stays live before auto-expiring, in minutes
CHIP_TTL_MINUTES=90

# Default search radius for nearby parking / chips, in meters
PARKING_RADIUS_METERS=800

# OpenStreetMap Overpass endpoint (used to fetch legal amenity=parking near a point)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Abuse guards for anonymous chip/device creation (in-memory, per-process; move to
# a shared store like Redis if you run more than one API instance).
RATE_WINDOW_MINUTES=60
CHIP_RATE_MAX_PER_DEVICE=6
CHIP_RATE_MAX_PER_IP=12
DEVICE_RATE_MAX_PER_IP=8

# Coarse presence check: reject a chip when the request IP geolocates more than
# PRESENCE_MAX_KM from the claimed spot (local geo-IP DB, no third-party calls,
# nothing stored). Reliably catches cross-continent spoofing; it CANNOT tell a
# spoofer in the US claiming PR apart from a real PR user whose mobile carrier
# routes through the US mainland, so keep the radius forgiving. Fail-open on
# unknown/localhost IPs. Set PRESENCE_CHECK_ENABLED=false to turn it off.
PRESENCE_CHECK_ENABLED=true
PRESENCE_MAX_KM=500

# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (matches docker-compose defaults)
DATABASE_URL=postgres://protest:protest@localhost:5432/protest_tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_ROUNDS=12

# OpenRouteService (routing + avoid-area). Free hosted key at
# https://openrouteservice.org/dev/#/signup — or point ORS_BASE_URL at a
# self-hosted instance. Leave ORS_API_KEY blank for now; /match returns a clear
# 503 until it is set.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=driving-car

# CORS: comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Conflict buffer around protest routes, in meters
MATCH_BUFFER_METERS=200

# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.

# Base URL of the backend API. Leave blank to use the dev proxy (/api -> :3000).
VITE_API_BASE_URL=

# Google Maps JavaScript API key (frontend; restrict by HTTP referrer).
# Not required until the map/route UI is wired up.
VITE_GOOGLE_MAPS_API_KEY=

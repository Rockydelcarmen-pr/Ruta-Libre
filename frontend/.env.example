# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.

# Base URL of the backend API. Leave blank to use the dev proxy (/api -> :3000).
VITE_API_BASE_URL=

# MapLibre GL style URL (vector tiles). Any provider works, e.g. MapTiler:
#   https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# or a self-hosted/Protomaps style. Not required until the map UI is wired up.
VITE_MAP_STYLE_URL=
